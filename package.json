# اكتب package.json مؤقت صالح للـ npm (سيستبدل الملف إن كان موجود)
cat > package.json <<'EOF'
{
  "name": "next-js-boilerplate",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest"
  },
  "dependencies": {
    "next": "^12.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "eslint": "^8.19.0",
    "typescript": "^4.7.4",
    "jest": "^28.1.2",
    "cypress": "^10.3.0"
  },
  "author": "Ixartz"
}
EOF

# تحقق من صلاحية JSON (اختياري)
node -e "JSON.parse(require('fs').readFileSync('package.json','utf8')); console.log('package.json is valid JSON')"

# أضف التغييرات إلى git واعمل commit و push
git add package.json
git commit -m "fix(package.json): restore valid JSON after accidental overwrite"
git push origin HEAD
